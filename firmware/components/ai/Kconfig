menu "Smart-Air AI"
    depends on SA_ENABLE_AI

    config SA_AI_TENSOR_ARENA_SIZE
        int "TFLite Micro tensor arena size (bytes)"
        default 24576
        range 8192 262144
        help
            Working buffer for the TFLite Micro interpreter, allocated once
            at boot from PSRAM (MALLOC_CAP_SPIRAM). The boot log prints the
            arena bytes actually used after AllocateTensors(); if it reports
            "AllocateTensors failed", increase this value.

    config SA_AI_WINDOW_BUCKET_SEC
        int "Seconds per window slot (3600 = 1 hour, production)"
        default 3600
        range 5 3600
        help
            The model is trained on 24 consecutive HOURLY means, so keep
            3600 for real use. Lowering it (e.g. 10 with the demo preset)
            fills the 24-slot window in minutes, which is only meant for
            bench-testing the alert path (buzzer + MQTT) end to end.

    config SA_AI_SELF_TEST
        bool "Run model self-test vectors at boot"
        default n
        help
            Runs the known windows in src/ai_selftest_vectors.h through the
            model once at boot and logs PASS/FAIL against the expected
            results. Regenerate that file with tools/gen_selftest_vectors.py.

endmenu
